NODE_ENV=development
APP_URL=http://localhost:3000

# cTrader Open API OAuth (set only after Spotware approves the app).
# This is the public client ID, not the client secret.
CTRADER_OPENAPI_CLIENT_ID=
DERIV_OAUTH_CLIENT_ID=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=


# FastAPI is mandatory for all Deriv operations. No direct-Deriv fallback is supported.
TRADEBRIDGE_BACKEND_URL=
TRADEBRIDGE_SESSION_BRIDGE_TOKEN=
NEXT_PUBLIC_TRADEBRIDGE_BACKEND_HTTP_URL=
NEXT_PUBLIC_TRADEBRIDGE_BACKEND_WS_URL=
NEXT_PUBLIC_TRADEBRIDGE_BACKEND_MARKET_WS_URL=
