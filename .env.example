NODE_ENV=development
APP_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# New publishable key (replaces NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# New secret key for server-only admin client (replaces SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_SECRET_KEY=sb_secret_...
# Legacy fallback — accepted until you deactivate legacy keys in Dashboard
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Deriv OAuth ───────────────────────────────────────────────────────────────
DERIV_OAUTH_CLIENT_ID=

# ── FastAPI backend ───────────────────────────────────────────────────────────
# FastAPI is mandatory for all Deriv operations. No direct-Deriv fallback.
TRADEBRIDGE_BACKEND_URL=https://your-backend.vercel.app
TRADEBRIDGE_SESSION_BRIDGE_TOKEN=
NEXT_PUBLIC_TRADEBRIDGE_BACKEND_HTTP_URL=https://your-backend.vercel.app
# Trading WebSocket — must include /deriv/ws path
NEXT_PUBLIC_TRADEBRIDGE_BACKEND_WS_URL=wss://your-backend.vercel.app/deriv/ws
# Market data WebSocket — must include /deriv/live/market path
NEXT_PUBLIC_TRADEBRIDGE_BACKEND_MARKET_WS_URL=wss://your-backend.vercel.app/deriv/live/market

# ── Cron ──────────────────────────────────────────────────────────────────────
CRON_SECRET=
