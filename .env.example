# Server-side OAuth 2.0 client ID from your Deriv OAuth application
DERIV_OAUTH_CLIENT_ID=

# Must match the domain registered in Deriv, including protocol and port.
# Callback path is /api/auth/deriv/callback
APP_URL=http://localhost:3000

# Never put client secrets or access tokens in NEXT_PUBLIC_* variables.

# TradeBridge platform authentication (Supabase Auth)
# Get both values from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase service-role key. Never expose through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
