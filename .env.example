# TradeBridge Frontend — environment variable template
# Copy to .env.local (Next.js reads .env.local for local dev) and fill in values.
# Never commit .env.local to version control.
#
# VERCEL DEPLOYMENT: add every variable below to your Vercel project's
# Environment Variables (Settings → Environment Variables). The local .env.local
# file is only used for local development — Vercel ignores it.
#
# NEXT_PUBLIC_ prefix = exposed to the browser bundle (safe for public values only)
# No prefix = server-only (never sent to the browser)

NODE_ENV=production

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=https://your-frontend.vercel.app

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# New publishable key — Dashboard › Settings › API Keys › Publishable and secret
# Replaces legacy NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# New secret key — server-only admin client, never expose to browser
# Replaces legacy SUPABASE_SERVICE_ROLE_KEY (JWT)
SUPABASE_SECRET_KEY=sb_secret_...

# ── Deriv OAuth ───────────────────────────────────────────────────────────────
# OAuth Client ID for the authorization code + PKCE flow
DERIV_OAUTH_CLIENT_ID=

# ── FastAPI backend ───────────────────────────────────────────────────────────
# Base URL of the backend (no trailing slash)
TRADEBRIDGE_BACKEND_URL=https://your-backend.vercel.app
NEXT_PUBLIC_TRADEBRIDGE_BACKEND_HTTP_URL=https://your-backend.vercel.app
# Authenticated trading WebSocket — MUST include /deriv/ws path
NEXT_PUBLIC_TRADEBRIDGE_BACKEND_WS_URL=wss://your-backend.vercel.app/deriv/ws
# Public market data WebSocket — MUST include /deriv/live/market path
NEXT_PUBLIC_TRADEBRIDGE_BACKEND_MARKET_WS_URL=wss://your-backend.vercel.app/deriv/live/market

# ── Shared secret ─────────────────────────────────────────────────────────────
# Must match TRADEBRIDGE_SESSION_BRIDGE_TOKEN in the backend exactly
TRADEBRIDGE_SESSION_BRIDGE_TOKEN=

# ── Cron ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=
